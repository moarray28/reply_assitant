# Frontend-safe Supabase project settings. These are exposed to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Enable after deploying supabase/functions/generate-reply.
# VITE_USE_SUPABASE_FUNCTIONS=true
# Set only in deployment; local Vite uses its /api proxy.
# VITE_API_BASE_URL=https://your-api-host.example/api

# Server settings. Never prefix private keys with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPENROUTER_API_KEY=your-server-only-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional; defaults to 3001.
PORT=3001
